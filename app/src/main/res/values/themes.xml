<resources>
    <style name="Chemodan.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">56dp</item>
        <item name="android:height">28dp</item>
    </style>
    <style name="Theme.Chemodan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorHeroSurface">@color/hero_surface</item>
        <item name="colorHeroForeground">@color/hero_foreground</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
    </style>
</resources>
